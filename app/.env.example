# Copy to .env (gitignored) and fill in. The server reads app/.env, or the file named by VELA_ENV_FILE.
# Shared secret. Clients send it as the x-vela-token header; open the app once with ?k=<token>.
APP_TOKEN=
# Speech to text (whisper-large-v3-turbo) and name/relation parsing (gpt-oss-20b).
GROQ_API_KEY=
# Vela's voice (Flash v2.5).
ELEVENLABS_API_KEY=
# Optional: Kokoro TTS fallback when ElevenLabs fails.
FEATHERLESS_API_KEY=
# Optional: Whisper fallback; also needs allow_openai in server/providers.json.
OPENAI_API_KEY=
